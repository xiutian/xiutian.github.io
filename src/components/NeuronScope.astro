---
// "Neuron microscope": a self-playing animation of a toy audio-language model.
// Each speech clip lights up a small group of emotion-sensitive neurons and the
// model predicts the emotion. Then the animation intervenes on those neurons:
// it switches a group off (ablation) or amplifies one (steering), and the
// prediction changes. Purely illustrative, not real model data.
const emotions = [
  { key: 'happy', label: 'Happy' },
  { key: 'angry', label: 'Angry' },
  { key: 'sad', label: 'Sad' },
  { key: 'surprise', label: 'Surprise' },
  { key: 'neutral', label: 'Neutral' },
];
---
<figure class="scope" data-scope aria-label="Animation: emotion-sensitive neurons inside an audio-language model, and how switching them off or amplifying them changes the model's prediction.">
  <div class="scope-top">
    <span class="scope-label"><span class="live"></span> Inside an audio-language model</span>
    <span class="scope-clip">Input: <strong data-clip>a happy voice</strong></span>
  </div>

  <div class="scope-body" aria-hidden="true">
    <div class="scope-canvas">
      <canvas></canvas>
    </div>
    <div class="preds">
      <p class="scope-label">Model prediction</p>
      <ol>
        {emotions.map((e) => (
          <li data-emo={e.key}>
            <span class="pl">{e.label}</span>
            <span class="bar"><i></i></span>
            <span class="pv">0%</span>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <figcaption class="scope-foot">
    <span class="phase" data-phase>Listen</span>
    <span class="status" data-status>Listening to a happy voice…</span>
    <ul class="legend" aria-hidden="true">
      {emotions.slice(0, 4).map((e) => <li data-emo={e.key}><i></i>{e.label}</li>)}
    </ul>
  </figcaption>
</figure>

<script>
  type Emo = 'happy' | 'angry' | 'sad' | 'surprise' | 'neutral';
  type Group = Exclude<Emo, 'neutral'>;
  type Mod = 'off' | 'boost';
  const EMOS: Emo[] = ['happy', 'angry', 'sad', 'surprise', 'neutral'];
  const GROUPS: Group[] = ['happy', 'angry', 'sad', 'surprise'];
  const LABEL: Record<Emo, string> = { happy: 'happy', angry: 'angry', sad: 'sad', surprise: 'surprised', neutral: 'neutral' };

  // Emotion-sensitive neurons as [layer, index], for the wide and narrow layouts.
  const ESN_WIDE: Record<Group, [number, number][]> = {
    happy: [[2, 1], [4, 4], [6, 2]],
    angry: [[3, 5], [5, 0], [6, 5]],
    sad: [[3, 2], [5, 3], [7, 4]],
    surprise: [[2, 5], [4, 1], [7, 1]],
  };
  const ESN_NARROW: Record<Group, [number, number][]> = {
    happy: [[1, 1], [3, 3], [4, 0]],
    angry: [[2, 4], [3, 0], [5, 2]],
    sad: [[2, 2], [4, 4], [5, 0]],
    surprise: [[1, 3], [3, 1], [5, 4]],
  };

  // Timeline of one clip, in seconds.
  const CLIP = 7;
  const SWEEP = 1.5;      // activation sweeps through the layers
  const INTERVENE = 3.4;  // intervention starts
  const FADE = 6.4;       // fade out before the next clip

  const root = document.querySelector<HTMLElement>('[data-scope]');
  const canvas = root?.querySelector('canvas');
  const ctx = canvas?.getContext('2d');

  if (root && canvas && ctx) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const clipEl = root.querySelector<HTMLElement>('[data-clip]')!;
    const phaseEl = root.querySelector<HTMLElement>('[data-phase]')!;
    const statusEl = root.querySelector<HTMLElement>('[data-status]')!;
    const rows = EMOS.map((e) => {
      const li = root.querySelector<HTMLElement>(`.preds li[data-emo="${e}"]`)!;
      return { li, bar: li.querySelector<HTMLElement>('i')!, val: li.querySelector<HTMLElement>('.pv')! };
    });

    let w = 0, h = 0;
    let L = 8, N = 7;
    let esn = ESN_WIDE;
    let colors: Record<string, string> = {};
    let shown = EMOS.map((e) => (e === 'neutral' ? 1 : 0));
    let last = performance.now();
    let raf = 0;
    let running = !reduce;
    const start = performance.now();

    const readColors = () => {
      const cs = getComputedStyle(document.documentElement);
      const v = (n: string) => cs.getPropertyValue(n).trim();
      colors = {
        happy: v('--emo-happy'), angry: v('--emo-angry'), sad: v('--emo-sad'), surprise: v('--emo-surprise'),
        neutral: v('--emo-neutral'), line: v('--line'), muted: v('--muted'), ink: v('--ink'), bg: v('--bg-raised'),
      };
    };

    const groupOf = (l: number, n: number): Group | null => {
      for (const g of GROUPS) if (esn[g].some(([a, b]) => a === l && b === n)) return g;
      return null;
    };

    const hash = (a: number, b: number, c: number) => {
      const x = Math.sin(a * 127.1 + b * 311.7 + c * 74.7) * 43758.5453;
      return x - Math.floor(x);
    };

    const inputW = () => Math.min(84, w * 0.13);
    const layerX = (l: number) => {
      const x0 = inputW() + 34, x1 = w - 16;
      return x0 + ((x1 - x0) * l) / (L - 1);
    };
    const neuronY = (n: number) => 22 + ((h - 44) * n) / (N - 1);

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const r = canvas.getBoundingClientRect();
      w = r.width; h = r.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const narrow = w < 520;
      L = narrow ? 6 : 8;
      N = narrow ? 5 : 7;
      esn = narrow ? ESN_NARROW : ESN_WIDE;
    };

    const setText = (el: HTMLElement, s: string) => { if (el.textContent !== s) el.textContent = s; };

    const draw = (now: number) => {
      const dt = Math.min(0.1, (now - last) / 1000);
      last = now;
      const t = reduce ? 0 : (now - start) / 1000;
      const clip = Math.floor(t / CLIP);
      const emo: Emo = reduce ? 'happy' : EMOS[clip % EMOS.length];
      const local = reduce ? 2.5 : t - clip * CLIP;
      const sweep = Math.min(1, local / SWEEP);
      const fade = Math.max(0, Math.min(1, (CLIP - local) / (CLIP - FADE)));
      const reach = (l: number) => Math.max(0, Math.min(1, (sweep * (L + 0.6) - l) / 0.8)) * fade;

      // Intervention: alternate between switching off the heard emotion's
      // neurons and amplifying another emotion's neurons.
      const round = Math.floor(clip / EMOS.length);
      let target: Group | null = null;
      let mod: Mod | null = null;
      const intervening = !reduce && emo !== 'neutral' && local >= INTERVENE;
      if (intervening) {
        if (round % 2 === 0) { target = emo as Group; mod = 'off'; }
        else { target = GROUPS[(GROUPS.indexOf(emo as Group) + 2) % GROUPS.length]; mod = 'boost'; }
      }
      // ramp the intervention in, so the change is visible but smooth
      const k = intervening ? Math.min(1, (local - INTERVENE) / 0.5) : 0;

      const act = (l: number, n: number) => {
        const g = groupOf(l, n);
        const r = reach(l);
        if (g) {
          let a = (emo === g ? 1 : 0.08) * r;
          if (g === target && mod === 'off') a *= 1 - k;
          if (g === target && mod === 'boost') a += 1.7 * k * fade;
          return a;
        }
        const flicker = reduce ? 0.5 : 0.5 + 0.5 * Math.sin(t * 3 + l * 1.7 + n * 2.3);
        return (0.12 + 0.4 * hash(l, n, clip)) * r * (0.7 + 0.3 * flicker);
      };

      // captions
      setText(clipEl, `a ${LABEL[emo]} voice`.replace('a angry', 'an angry'));
      if (reduce) {
        setText(phaseEl, 'Observe');
        setText(statusEl, 'Happy speech lights up the happy neurons, and the model predicts “happy”.');
      } else if (local < SWEEP + 0.3) {
        setText(phaseEl, 'Listen');
        setText(statusEl, `Listening to ${clipEl.textContent}…`);
      } else if (emo === 'neutral') {
        setText(phaseEl, 'Observe');
        setText(statusEl, 'Neutral speech: no emotion group fires.');
      } else if (!intervening) {
        setText(phaseEl, 'Observe');
        setText(statusEl, `The ${LABEL[emo]} neurons fire.`);
      } else if (mod === 'off') {
        setText(phaseEl, 'Switch off');
        setText(statusEl, `Switching off the ${LABEL[emo]} neurons: the model loses the emotion.`);
      } else {
        setText(phaseEl, 'Amplify');
        setText(statusEl, `Amplifying the ${LABEL[target!]} neurons: the prediction is steered to “${LABEL[target!]}”.`);
      }
      phaseEl.dataset.kind = mod ?? 'observe';

      ctx.clearRect(0, 0, w, h);
      const emoColor = emo === 'neutral' ? colors.muted : colors[emo];

      // input strip
      const iw = inputW();
      const bars = 14;
      const bw = iw / bars;
      for (let i = 0; i < bars; i++) {
        const wob = reduce ? 0.6 : 0.5 + 0.5 * Math.sin(t * 4 + i * 0.9 + clip);
        const amp = (0.25 + 0.75 * hash(i, clip, 3)) * (0.55 + 0.45 * wob) * fade;
        const bh = Math.max(3, amp * (h - 40));
        ctx.globalAlpha = 0.35 + 0.5 * amp;
        ctx.fillStyle = emoColor;
        ctx.beginPath();
        ctx.roundRect(i * bw + 1, h / 2 - bh / 2, Math.max(1.5, bw - 2.5), bh, 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;

      // connections
      ctx.lineWidth = 1;
      ctx.strokeStyle = colors.line;
      ctx.beginPath();
      for (let n = 0; n < N; n++) { ctx.moveTo(iw + 4, h / 2); ctx.lineTo(layerX(0), neuronY(n)); }
      for (let l = 0; l < L - 1; l++) {
        for (let a = 0; a < N; a++) for (let b = 0; b < N; b++) {
          ctx.moveTo(layerX(l), neuronY(a));
          ctx.lineTo(layerX(l + 1), neuronY(b));
        }
      }
      ctx.globalAlpha = 0.55;
      ctx.stroke();
      ctx.globalAlpha = 1;

      // wave front
      if (!reduce && sweep < 1) {
        const fx = layerX(0) + (layerX(L - 1) - layerX(0)) * sweep;
        const grad = ctx.createLinearGradient(fx - 60, 0, fx + 10, 0);
        grad.addColorStop(0, 'rgba(0,0,0,0)');
        grad.addColorStop(1, emoColor);
        ctx.globalAlpha = 0.12;
        ctx.fillStyle = grad;
        ctx.fillRect(fx - 60, 0, 70, h);
        ctx.globalAlpha = 1;
      }

      // emotion circuits
      for (const g of GROUPS) {
        const list = esn[g];
        const isOff = g === target && mod === 'off' && k > 0.5;
        const strength = Math.max(...list.map(([l, n]) => act(l, n)));
        if (strength < 0.05 && !isOff) continue;
        ctx.strokeStyle = colors[g];
        ctx.lineWidth = g === target && mod === 'boost' ? 2.4 : 1.6;
        ctx.globalAlpha = isOff ? 0.3 * fade : Math.min(0.85, strength * 0.7);
        if (isOff) ctx.setLineDash([3, 4]);
        ctx.beginPath();
        list.forEach(([l, n], i) => (i ? ctx.lineTo(layerX(l), neuronY(n)) : ctx.moveTo(layerX(l), neuronY(n))));
        ctx.stroke();
        ctx.setLineDash([]);
        ctx.globalAlpha = 1;
      }

      // neurons
      for (let l = 0; l < L; l++) {
        for (let n = 0; n < N; n++) {
          const x = layerX(l), y = neuronY(n);
          const g = groupOf(l, n);
          const a = act(l, n);
          const isOff = g !== null && g === target && mod === 'off' && k > 0.5;
          const isBoost = g !== null && g === target && mod === 'boost';
          const r = g ? 4.5 + 2.5 * Math.min(1.4, a) : 3 + 1.5 * a;

          ctx.beginPath();
          ctx.arc(x, y, isOff ? 4.5 : r, 0, Math.PI * 2);
          if (isOff) {
            ctx.fillStyle = colors.bg;
            ctx.fill();
            ctx.strokeStyle = colors[g!];
            ctx.globalAlpha = fade;
            ctx.lineWidth = 1.4;
            ctx.stroke();
            ctx.beginPath();
            ctx.moveTo(x - 2.2, y - 2.2); ctx.lineTo(x + 2.2, y + 2.2);
            ctx.moveTo(x + 2.2, y - 2.2); ctx.lineTo(x - 2.2, y + 2.2);
            ctx.stroke();
            ctx.globalAlpha = 1;
          } else if (g) {
            if (a > 0.05) { ctx.shadowColor = colors[g]; ctx.shadowBlur = 8 + 14 * Math.min(1.5, a); }
            ctx.fillStyle = colors[g];
            ctx.globalAlpha = 0.28 + 0.72 * Math.min(1, a);
            ctx.fill();
            ctx.globalAlpha = 1;
            ctx.shadowBlur = 0;
            if (isBoost && k > 0) {
              ctx.beginPath();
              ctx.arc(x, y, r + 4 + 1.5 * Math.sin(t * 6), 0, Math.PI * 2);
              ctx.strokeStyle = colors[g];
              ctx.globalAlpha = k * fade;
              ctx.lineWidth = 1.2;
              ctx.stroke();
              ctx.globalAlpha = 1;
            }
          } else {
            ctx.fillStyle = colors.ink;
            ctx.globalAlpha = 0.16 + 0.6 * Math.min(1, a);
            ctx.fill();
            ctx.globalAlpha = 1;
          }
        }
      }

      // layer labels
      ctx.fillStyle = colors.muted;
      ctx.font = '500 10px "JetBrains Mono Variable", ui-monospace, monospace';
      ctx.textAlign = 'center';
      ctx.fillText('in', iw / 2, h - 4);
      for (let l = 0; l < L; l++) ctx.fillText(`L${l + 1}`, layerX(l), h - 4);

      // prediction: softmax over each group's evidence; neutral is the baseline
      const scores = EMOS.map((e) => (e === 'neutral' ? 2.2 : esn[e].reduce((s, [l, n]) => s + act(l, n) * 2, 0)));
      const ex = scores.map((s) => Math.exp(s * 1.3));
      const sum = ex.reduce((x, y) => x + y, 0);
      const ease = reduce ? 1 : 1 - Math.exp(-dt * 9); // frame-rate independent smoothing
      shown = shown.map((v, i) => v + (ex[i] / sum - v) * ease);
      const top = shown.indexOf(Math.max(...shown));
      rows.forEach((row, i) => {
        row.bar.style.width = `${(shown[i] * 100).toFixed(1)}%`;
        row.val.textContent = `${Math.round(shown[i] * 100)}%`;
        row.li.classList.toggle('top', i === top);
      });
    };

    const loop = (now: number) => {
      draw(now);
      if (running) raf = requestAnimationFrame(loop);
    };

    readColors();
    resize();
    draw(performance.now());
    if (!reduce) {
      raf = requestAnimationFrame(loop);
      // pause while scrolled out of view
      new IntersectionObserver(([entry]) => {
        running = entry.isIntersecting;
        cancelAnimationFrame(raf);
        if (running) { last = performance.now(); raf = requestAnimationFrame(loop); }
      }).observe(root);
    }
    new ResizeObserver(() => { resize(); draw(performance.now()); }).observe(canvas);
    const recolor = () => { readColors(); draw(performance.now()); };
    window.addEventListener('themechange', recolor);
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', recolor);
  }
</script>

<style>
  .scope {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: 20px;
    background: var(--bg-raised);
    padding: 18px 20px 16px;
  }
  .scope [data-emo='happy'] { --c: var(--emo-happy); }
  .scope [data-emo='angry'] { --c: var(--emo-angry); }
  .scope [data-emo='sad'] { --c: var(--emo-sad); }
  .scope [data-emo='surprise'] { --c: var(--emo-surprise); }
  .scope [data-emo='neutral'] { --c: var(--emo-neutral); }

  .scope-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 16px;
    margin-bottom: 10px;
  }
  .scope-label {
    margin: 0;
    font: 500 11.5px var(--font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .live {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--accent);
    animation: live 1.6s ease-in-out infinite;
  }
  @keyframes live { 50% { opacity: 0.3; } }
  .scope-clip { font: 12.5px var(--font-mono); color: var(--muted); }
  .scope-clip strong { color: var(--ink); font-weight: 600; }

  .scope-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: 24px;
    align-items: center;
  }
  .scope-canvas { position: relative; height: 250px; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; }

  .preds ol { list-style: none; margin: 10px 0 0; padding: 0; display: grid; gap: 9px; }
  .preds li {
    display: grid;
    grid-template-columns: 66px 1fr 38px;
    align-items: center;
    gap: 10px;
    font-size: 13.5px;
    color: var(--muted);
  }
  .preds .bar { height: 8px; border-radius: 999px; background: var(--line); overflow: hidden; }
  .preds .bar i {
    display: block;
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: var(--c);
    opacity: 0.45;
  }
  .preds .pv { font: 500 12px var(--font-mono); text-align: right; font-variant-numeric: tabular-nums; }
  .preds li.top { color: var(--ink); font-weight: 600; }
  .preds li.top .bar i { opacity: 1; }

  .scope-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  .phase {
    flex: none;
    min-width: 86px;
    text-align: center;
    font: 500 11.5px var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 5px 10px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--ink-2);
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }
  .phase[data-kind='off'],
  .phase[data-kind='boost'] { background: var(--ink); border-color: var(--ink); color: var(--bg); }
  .status { flex: 1 1 240px; font-size: 13.5px; color: var(--muted); }
  .legend { display: flex; gap: 12px; list-style: none; margin: 0; padding: 0; font: 12px var(--font-mono); color: var(--muted); }
  .legend li { display: inline-flex; align-items: center; gap: 6px; }
  .legend i { width: 8px; height: 8px; border-radius: 50%; background: var(--c); box-shadow: 0 0 8px var(--c); }

  @media (max-width: 760px) {
    .scope { padding: 14px 14px 12px; }
    .scope-body { grid-template-columns: minmax(0, 1fr); gap: 14px; }
    .scope-canvas { height: 210px; }
    .legend { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .live { animation: none; }
  }
</style>
