---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import NeuronScope from '../components/NeuronScope.astro';
import PubItem from '../components/PubItem.astro';
import Icon from '../components/Icon.astro';
import { Content as Bio } from '../data/bio.md';
import { site } from '../data/site';
import { getPublications } from '../lib/bibtex';
import portrait from '../assets/prof_pic.jpg';

const pubs = getPublications();
const selected = pubs.filter((p) => p.selected);

const news = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const newsItems = await Promise.all(news.map(async (n) => ({ date: n.data.date, Content: (await render(n)).Content })));
const fmt = new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<BaseLayout>
  <section class="hero container">
    <div class="hero-text">
      <p class="eyebrow hero-eyebrow"><span class="dot"></span> PhD student · CLSP · Johns Hopkins</p>
      <h1 class="display hero-name">
        Xiutian <em>(Theo)</em> Zhao
      </h1>
      <p class="hero-lede">
        I look inside audio-language models to see how they represent <em>human</em> concepts,
        like emotion and speech-based diagnostic cues, and turn what we find into something utilizable.
      </p>
      <div class="hero-cta">
        <a class="btn primary" href="/publications/">Publications <Icon name="arrow" size={16} /></a>
        <a class="icon-btn" href={`mailto:${site.email}`} aria-label="Email"><Icon name="mail" /></a>
        <a class="icon-btn" href="https://scholar.google.com/citations?user=HfOmKncAAAAJ" target="_blank" rel="noopener" aria-label="Google Scholar"><Icon name="scholar" /></a>
        <a class="icon-btn" href="https://github.com/xiutian" target="_blank" rel="noopener" aria-label="GitHub"><Icon name="github" /></a>
      </div>
    </div>
    <figure class="hero-portrait">
      <Image
        src={portrait}
        alt="Xiutian Zhao in London"
        widths={[360, 560, 840]}
        sizes="(max-width: 860px) 70vw, 380px"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>London · © Y. Deng</figcaption>
    </figure>
  </section>

  <div class="container hero-wave">
    <NeuronScope />
  </div>

  <section class="container about" data-reveal>
    <p class="eyebrow">About</p>
    <div class="prose"><Bio /></div>
  </section>

  <section class="container block" data-reveal>
    <div class="section-head">
      <h2>Selected papers</h2>
      <a href="/publications/">All {pubs.length} publications →</a>
    </div>
    <div class="selected">
      {selected.map((p) => <PubItem pub={p} compact />)}
    </div>
  </section>

  <section class="container block" data-reveal>
    <div class="section-head">
      <h2>News</h2>
    </div>
    <ol class="news">
      {newsItems.map(({ date, Content }) => (
        <li>
          <time datetime={date.toISOString().slice(0, 10)}>{fmt.format(date)}</time>
          <div class="news-body"><Content /></div>
        </li>
      ))}
    </ol>
  </section>

  <section class="container block" data-reveal>
    <a class="gallery-teaser" href="/gallery/">
      <span class="eyebrow">Off the clock</span>
      <span class="display teaser-title">A day in twelve frames <Icon name="arrow" size={28} /></span>
      <span class="teaser-sub">Landscape photos from Fairbanks to Kyoto, one for every two hours of the day.</span>
    </a>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 380px;
    align-items: end;
    gap: 56px;
    padding-top: clamp(48px, 9vw, 110px);
  }
  .hero-eyebrow { display: inline-flex; align-items: center; gap: 10px; }
  .dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  .hero-name {
    font-size: clamp(42px, 7vw, 88px);
    margin-top: 18px;
  }
  .hero-name em {
    font-style: italic;
    color: var(--muted);
    font-size: 0.62em;
    vertical-align: 0.08em;
  }
  .hero-lede {
    margin: 26px 0 0;
    max-width: 34ch;
    font-size: clamp(19px, 2.2vw, 23px);
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .hero-lede em {
    font-family: var(--font-serif);
    font-size: 1.15em;
    color: var(--accent-ink);
  }
  .hero-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 34px; }
  .btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 11px 18px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    font-size: 15px; font-weight: 500;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
  }
  .btn:hover { border-color: var(--ink); color: var(--ink); transform: translateY(-1px); }
  .btn.primary { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .btn.primary:hover { background: var(--accent); border-color: var(--accent); color: #fff; }
  .icon-btn {
    display: grid; place-items: center;
    width: 44px; height: 44px;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--ink-2);
  }
  .icon-btn:hover { border-color: var(--accent); color: var(--accent-ink); }

  .hero-portrait { margin: 0; }
  .hero-portrait :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 20px;
    box-shadow: var(--shadow);
  }
  .hero-portrait figcaption {
    margin-top: 10px;
    font: 12px var(--font-mono);
    color: var(--muted);
    text-align: right;
  }

  .hero-wave { margin-top: clamp(24px, 5vw, 56px); }

  .about {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 28px;
    margin-top: clamp(40px, 7vw, 80px);
  }
  .prose { max-width: 66ch; font-size: 18px; color: var(--ink-2); }
  .prose :global(p) { margin: 0 0 1.1em; }
  .prose :global(p:last-child) { margin-bottom: 0; }
  .prose :global(strong) { color: var(--ink); font-weight: 600; }

  .block { margin-top: clamp(64px, 9vw, 110px); }

  .news { list-style: none; margin: 0; padding: 0; }
  .news li {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 28px;
    padding-block: 18px;
    border-bottom: 1px solid var(--line);
  }
  .news li:last-child { border-bottom: 0; }
  .news time { font: 13px/1.9 var(--font-mono); color: var(--muted); }
  .news-body { color: var(--ink-2); }
  .news-body :global(p) { margin: 0; }
  /* Flags drawn as images: Windows can't display flag emoji. */
  .news-body :global(img.emoji) {
    display: inline-block;
    height: 0.95em;
    width: auto;
    vertical-align: -0.1em;
    margin-inline: 0.1em;
    border-radius: 2px;
    box-shadow: 0 0 0 1px var(--line);
  }

  .gallery-teaser {
    position: relative;
    display: grid;
    gap: 10px;
    padding: clamp(28px, 5vw, 56px);
    border-radius: 24px;
    text-decoration: none;
    color: #f4f1ff;
    overflow: hidden;
    background:
      radial-gradient(120% 140% at 0% 0%, #2a1f5c 0%, transparent 55%),
      radial-gradient(90% 120% at 100% 100%, #ff7a4d 0%, transparent 55%),
      linear-gradient(120deg, #0d0b1f, #3a2366 55%, #c2502f);
    transition: transform 0.25s ease;
  }
  .gallery-teaser:hover { color: #fff; transform: translateY(-2px); }
  .gallery-teaser .eyebrow { color: rgb(255 255 255 / 0.7); }
  .teaser-title {
    display: inline-flex; align-items: center; gap: 14px;
    font-size: clamp(34px, 5.5vw, 60px);
  }
  .teaser-title :global(svg) { transition: transform 0.25s ease; }
  .gallery-teaser:hover .teaser-title :global(svg) { transform: translateX(6px); }
  .teaser-sub { max-width: 46ch; color: rgb(255 255 255 / 0.78); }

  @media (max-width: 860px) {
    .hero { grid-template-columns: 1fr; gap: 36px; }
    .hero-portrait { max-width: 320px; }
    .about { grid-template-columns: 1fr; gap: 10px; }
    .news li { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
