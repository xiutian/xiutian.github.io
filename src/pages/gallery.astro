---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { frames } from '../data/gallery';

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*.{jpg,jpeg,png,webp}', { eager: true });
const byName = Object.fromEntries(Object.entries(files).map(([p, m]) => [p.split('/').pop()!, m.default]));

// Sky colour for each hour, used for the dial and accents.
const SKY: [number, string][] = [
  [0, '#0d1230'], [3, '#1c2456'], [5, '#5a4a8a'], [6, '#f0a15e'], [8, '#8cc4f2'],
  [12, '#4fa3e6'], [15, '#7cb7e8'], [17, '#f5b964'], [18, '#f2724a'], [19.5, '#6b3f7a'],
  [21, '#232a5e'], [24, '#0d1230'],
];
const hex = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
function skyAt(hour: number) {
  for (let i = 0; i < SKY.length - 1; i++) {
    const [h0, c0] = SKY[i];
    const [h1, c1] = SKY[i + 1];
    if (hour >= h0 && hour <= h1) {
      const t = (hour - h0) / (h1 - h0);
      const a = hex(c0), b = hex(c1);
      return `rgb(${a.map((v, k) => Math.round(v + (b[k] - v) * t)).join(' ')})`;
    }
  }
  return SKY[0][1];
}

const items = await Promise.all(
  frames.map(async (f, i) => {
    const src = byName[f.file];
    if (!src) throw new Error(`Gallery image not found: src/assets/gallery/${f.file}`);
    const full = await getImage({ src, width: Math.min(src.width, 2000), format: 'webp', quality: 78 });
    return { ...f, src, full: full.src, sky: skyAt(f.hour), time: `${String(f.hour).padStart(2, '0')}:00`, index: i };
  }),
);
---
<BaseLayout title="Gallery" description="A day in twelve frames: landscape photography by Xiutian (Theo) Zhao, one photo for every two hours of the day.">
  <section class="container page-head">
    <p class="eyebrow">Gallery</p>
    <h1 class="display">A day in<br /><em>twelve frames</em></h1>
    <p class="lede">
      Photos from my travels, arranged by the hour they were taken: from a half moon over Sanya at 2 a.m.
      to the lights of Lower Manhattan at midnight.
    </p>
  </section>

  <div class="container day">
    <aside class="clock" aria-hidden="true">
      <div class="dial" style={`--sky:${items[0].sky}`}>
        <svg viewBox="0 0 200 200">
          <circle class="ring" cx="100" cy="100" r="86" />
          {Array.from({ length: 24 }, (_, h) => {
            const a = (h / 24) * Math.PI * 2 - Math.PI / 2;
            const r1 = h % 6 === 0 ? 70 : 76;
            return (
              <line
                class:list={['tick', { major: h % 6 === 0 }]}
                x1={100 + Math.cos(a) * r1} y1={100 + Math.sin(a) * r1}
                x2={100 + Math.cos(a) * 82} y2={100 + Math.sin(a) * 82}
              />
            );
          })}
          {[0, 6, 12, 18].map((h) => {
            const a = (h / 24) * Math.PI * 2 - Math.PI / 2;
            return <text x={100 + Math.cos(a) * 56} y={100 + Math.sin(a) * 56 + 4}>{String(h).padStart(2, '0')}</text>;
          })}
          <g class="hand" style={`transform: rotate(${(items[0].hour / 24) * 360}deg)`}>
            <line x1="100" y1="100" x2="100" y2="26" />
            <circle cx="100" cy="26" r="6" />
          </g>
          <circle class="hub" cx="100" cy="100" r="4" />
        </svg>
      </div>
      <p class="clock-time" data-clock-time>{items[0].time}</p>
      <p class="clock-place" data-clock-place>{items[0].place}</p>
    </aside>

    <ol class="frames">
      {items.map((it) => (
        <li class="frame" data-frame data-hour={it.hour} data-sky={it.sky} data-time={it.time} data-place={it.place} data-reveal>
          <button
            class="shot"
            type="button"
            data-full={it.full}
            data-caption={`${it.time} · ${it.place} — ${it.caption}${it.credit ? ` (© ${it.credit})` : ''}`}
            aria-label={`Enlarge: ${it.caption}, ${it.place}`}
          >
            <Image
              src={it.src}
              alt={`${it.caption}, ${it.place}`}
              widths={[480, 800, 1200, 1600]}
              sizes="(max-width: 860px) 100vw, 760px"
              quality={80}
              loading={it.index < 2 ? 'eager' : 'lazy'}
            />
          </button>
          <div class="frame-text">
            <span class="frame-time" style={`--sky:${it.sky}`}>{it.time}</span>
            <div>
              <p class="frame-place">{it.place}</p>
              <p class="frame-caption">{it.caption}{it.credit && <span class="credit"> · © {it.credit}</span>}</p>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>

  <dialog class="lightbox" aria-label="Photo viewer">
    <button class="lb-close" type="button" aria-label="Close"><Icon name="close" size={22} /></button>
    <img alt="" />
    <p class="lb-caption"></p>
  </dialog>
</BaseLayout>

<script>
  // Clock follows the frame in view.
  const dial = document.querySelector<HTMLElement>('.dial');
  const hand = document.querySelector<SVGGElement>('.hand');
  const timeEl = document.querySelector('[data-clock-time]');
  const placeEl = document.querySelector('[data-clock-place]');
  let angle = 0;

  const setFrame = (el: HTMLElement) => {
    const hour = Number(el.dataset.hour);
    // keep turning forward through midnight instead of spinning back
    let target = (hour / 24) * 360;
    while (target < angle - 180) target += 360;
    while (target > angle + 180) target -= 360;
    angle = target;
    if (hand) hand.style.transform = `rotate(${angle}deg)`;
    dial?.style.setProperty('--sky', el.dataset.sky ?? '');
    if (timeEl) timeEl.textContent = el.dataset.time ?? '';
    if (placeEl) placeEl.textContent = el.dataset.place ?? '';
  };

  const frames = [...document.querySelectorAll<HTMLElement>('[data-frame]')];
  if (frames[0]) angle = (Number(frames[0].dataset.hour) / 24) * 360;
  let current: HTMLElement | undefined;
  // Pick the frame whose centre is closest to the middle of the viewport.
  // (12 rect reads per scroll event is cheap, so no throttling needed.)
  const update = () => {
    const mid = window.innerHeight / 2;
    let best: HTMLElement | undefined;
    let bestDist = Infinity;
    for (const f of frames) {
      const r = f.getBoundingClientRect();
      const d = Math.abs(r.top + r.height / 2 - mid);
      if (d < bestDist) { bestDist = d; best = f; }
    }
    if (best && best !== current) { current = best; setFrame(best); }
  };
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
  update();

  // Lightbox
  const lb = document.querySelector<HTMLDialogElement>('.lightbox');
  const lbImg = lb?.querySelector('img');
  const lbCap = lb?.querySelector('.lb-caption');
  document.querySelectorAll<HTMLButtonElement>('.shot').forEach((b) => {
    b.addEventListener('click', () => {
      if (!lb || !lbImg || !lbCap) return;
      lbImg.src = b.dataset.full ?? '';
      lbImg.alt = b.querySelector('img')?.alt ?? '';
      lbCap.textContent = b.dataset.caption ?? '';
      lb.showModal();
    });
  });
  lb?.querySelector('.lb-close')?.addEventListener('click', () => lb.close());
  lb?.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
</script>

<style>
  .page-head { padding-top: clamp(48px, 8vw, 96px); padding-bottom: clamp(32px, 6vw, 72px); }
  .page-head h1 { font-size: clamp(56px, 10vw, 112px); margin-top: 14px; }
  .page-head h1 em { color: var(--accent-ink); }
  .lede { max-width: 52ch; margin: 22px 0 0; font-size: 18px; color: var(--ink-2); }

  .day {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: clamp(28px, 6vw, 80px);
    align-items: start;
  }

  .clock {
    position: sticky;
    top: 96px;
    text-align: center;
  }
  .dial {
    --sky: #0d1230;
    width: 100%;
    max-width: 200px;
    margin-inline: auto;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 35%, color-mix(in oklab, var(--sky) 55%, var(--bg)) 0%, var(--bg-raised) 72%);
    box-shadow: 0 0 0 1px var(--line), 0 20px 50px -20px var(--sky);
    transition: background 0.8s ease, box-shadow 0.8s ease;
  }
  .dial svg { display: block; width: 100%; height: auto; }
  .ring { fill: none; stroke: var(--line-strong); stroke-width: 1; }
  .tick { stroke: var(--muted); stroke-width: 1; opacity: 0.6; }
  .tick.major { stroke: var(--ink); stroke-width: 1.6; opacity: 1; }
  .dial text {
    font: 500 11px var(--font-mono);
    fill: var(--muted);
    text-anchor: middle;
  }
  .hand {
    transform-origin: 100px 100px;
    transition: transform 0.9s cubic-bezier(0.3, 0.8, 0.2, 1);
  }
  .hand line { stroke: var(--ink); stroke-width: 2; stroke-linecap: round; }
  .hand circle { fill: var(--sky); stroke: var(--bg); stroke-width: 2.5; transition: fill 0.8s ease; }
  .hub { fill: var(--ink); }
  .clock-time {
    margin: 18px 0 0;
    font: 500 34px/1 var(--font-mono);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .clock-place { margin: 8px 0 0; color: var(--muted); font-size: 14px; }

  .frames { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(56px, 9vw, 120px); }
  .frame { display: grid; gap: 18px; }
  .shot {
    display: block;
    padding: 0;
    border: 0;
    background: var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    cursor: zoom-in;
    box-shadow: var(--shadow);
  }
  .shot :global(img) {
    width: 100%;
    max-height: 82vh;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .shot:hover :global(img) { transform: scale(1.015); }

  .frame-text { display: flex; align-items: baseline; gap: 18px; }
  .frame-time {
    font: 500 14px var(--font-mono);
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    position: relative;
    padding-left: 24px;
    flex: none;
  }
  .frame-time::before {
    content: '';
    position: absolute;
    left: 9px;
    top: 50%;
    width: 8px;
    height: 8px;
    margin-top: -4px;
    border-radius: 50%;
    background: var(--sky);
  }
  .frame-place { margin: 0; font-weight: 600; }
  .frame-caption { margin: 2px 0 0; color: var(--muted); font-size: 15px; }
  .credit { font-size: 13px; }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: clamp(16px, 4vw, 48px);
    border: 0;
    background: rgb(8 8 12 / 0.94);
    color: #eee;
  }
  .lightbox[open] { display: grid; grid-template-rows: 1fr auto; place-items: center; gap: 16px; }
  .lightbox::backdrop { background: transparent; }
  .lightbox img { max-width: 100%; max-height: calc(100dvh - 140px); object-fit: contain; border-radius: 6px; }
  .lb-caption { margin: 0; font: 13px var(--font-mono); color: #bbb; text-align: center; }
  .lb-close {
    position: absolute;
    top: 16px;
    right: 16px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.2);
    background: rgb(255 255 255 / 0.06);
    color: #fff;
    cursor: pointer;
  }

  @media (max-width: 860px) {
    .day { grid-template-columns: 1fr; gap: 0; }
    .clock {
      top: 56px;
      z-index: 10;
      display: flex;
      align-items: center;
      gap: 14px;
      text-align: left;
      padding: 10px 0;
      margin-bottom: 24px;
      background: color-mix(in oklab, var(--bg) 88%, transparent);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--line);
    }
    .dial { width: 52px; margin: 0; }
    .dial text, .tick:not(.major) { display: none; }
    .clock-time { margin: 0; font-size: 22px; }
    .clock-place { margin: 0; }
  }
</style>
