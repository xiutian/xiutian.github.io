---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { site, nav } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
const path = Astro.url.pathname.replace(/\/+$/, '/') || '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#f7f8fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0e14" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        try {
          const t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') root.dataset.theme = t;
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href="/" aria-label="Home">
          <svg class="brand-mark" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <line x1="4" y1="4" x2="20" y2="20" />
            <line x1="20" y1="4" x2="4" y2="20" />
            <circle class="n n1" cx="4" cy="4" r="2.6" />
            <circle class="n n2" cx="20" cy="4" r="2.6" />
            <circle class="n n3" cx="20" cy="20" r="2.6" />
            <circle class="n n4" cx="4" cy="20" r="2.6" />
            <circle class="core" cx="12" cy="12" r="4" />
          </svg>
          <span class="brand-name">Xiutian Zhao</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map((item) => {
              const active = item.href === '/' ? path === '/' : path.startsWith(item.href);
              return (
                <li>
                  <a href={item.href} aria-current={active ? 'page' : undefined}>{item.label}</a>
                </li>
              );
            })}
          </ul>
        </nav>
        <button class="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
          <span class="icon-sun"><Icon name="sun" /></span>
          <span class="icon-moon"><Icon name="moon" /></span>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container foot-bottom">
        <span>© {year} {site.name}</span>
        <span>Built with Astro and Claude · Hosted on GitHub Pages</span>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const isDark = () =>
        root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      toggle?.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        window.dispatchEvent(new CustomEvent('themechange'));
      });

      const reveal = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
          }),
          { rootMargin: '0px 0px -8% 0px' },
        );
        reveal.forEach((el) => io.observe(el));
      } else {
        reveal.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 12px;
    top: -48px;
    padding: 8px 14px;
    background: var(--ink);
    color: var(--bg);
    border-radius: 8px;
    z-index: 100;
    text-decoration: none;
  }
  .skip:focus { top: 12px; }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    background: color-mix(in oklab, var(--bg) 78%, transparent);
    border-bottom: 1px solid color-mix(in oklab, var(--line) 70%, transparent);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 20px;
    height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-right: auto;
  }
  /* Neuron X mark: corners light up in turn and the centre pulses on hover */
  .brand-mark { flex: none; overflow: visible; }
  .brand-mark line { stroke: var(--line-strong); stroke-width: 1.8; stroke-linecap: round; }
  .brand-mark .n { fill: var(--muted); transition: fill 0.2s ease; }
  .brand-mark .core { fill: var(--accent); transform-origin: 12px 12px; }
  .brand:hover .brand-mark .core,
  .brand:focus-visible .brand-mark .core { animation: core-pulse 1.6s ease-in-out infinite; }
  .brand:hover .brand-mark .n,
  .brand:focus-visible .brand-mark .n { animation: corner-light 1.6s ease-in-out infinite; }
  .brand-mark .n2 { animation-delay: 0.2s !important; }
  .brand-mark .n3 { animation-delay: 0.4s !important; }
  .brand-mark .n4 { animation-delay: 0.6s !important; }
  @keyframes core-pulse {
    0%, 100% { transform: scale(1); }
    15% { transform: scale(1.3); }
    40% { transform: scale(1); }
  }
  @keyframes corner-light {
    0%, 12%, 60%, 100% { fill: var(--muted); }
    25%, 45% { fill: var(--accent); }
  }

  nav ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 14.5px;
    color: var(--ink-2);
    text-decoration: none;
  }
  nav a:hover { color: var(--ink); background: var(--line); }
  nav a[aria-current='page'] { color: var(--ink); background: var(--line); }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    flex: none;
  }
  .theme-toggle:hover { color: var(--ink); border-color: var(--line-strong); }
  .icon-moon { display: none; }
  :global(:root[data-theme='dark']) .icon-sun { display: none; }
  :global(:root[data-theme='dark']) .icon-moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-sun { display: none; }
    :global(:root:not([data-theme='light'])) .icon-moon { display: block; }
  }

  @media (max-width: 640px) {
    .bar { gap: 8px; height: 56px; }
    .brand-name { display: none; }
    nav a { padding: 6px 9px; font-size: 14px; }
    nav ul { gap: 0; }
  }

  .site-footer {
    margin-top: 120px;
    border-top: 1px solid var(--line);
    padding-block: 24px 28px;
  }
  .foot-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
</style>
