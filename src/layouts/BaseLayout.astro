---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { site, nav } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : site.title;
const path = Astro.url.pathname.replace(/\/+$/, '/') || '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#f5f3ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0d11" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        root.classList.add('js');
        try {
          const t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') root.dataset.theme = t;
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href="/" aria-label="Home">
          <span class="brand-mark" aria-hidden="true">
            <i></i><i></i><i></i><i></i><i></i>
          </span>
          <span class="brand-name">Xiutian Zhao</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map((item) => {
              const active = item.href === '/' ? path === '/' : path.startsWith(item.href);
              return (
                <li>
                  <a href={item.href} aria-current={active ? 'page' : undefined}>{item.label}</a>
                </li>
              );
            })}
          </ul>
        </nav>
        <button class="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
          <span class="icon-sun"><Icon name="sun" /></span>
          <span class="icon-moon"><Icon name="moon" /></span>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container foot">
        <div>
          <p class="foot-name display">{site.title}</p>
          <p class="foot-meta">{site.role}</p>
        </div>
        <ul class="foot-links">
          {site.links.map((l) => (
            <li>
              <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
                <Icon name={l.icon} size={16} /> {l.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="container foot-bottom">
        <span>© {year} {site.name}</span>
        <span>Built with Astro · Hosted on GitHub Pages</span>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const toggle = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const isDark = () =>
        root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      toggle?.addEventListener('click', () => {
        const next = isDark() ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        window.dispatchEvent(new CustomEvent('themechange'));
      });

      const reveal = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
          }),
          { rootMargin: '0px 0px -8% 0px' },
        );
        reveal.forEach((el) => io.observe(el));
      } else {
        reveal.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 12px;
    top: -48px;
    padding: 8px 14px;
    background: var(--ink);
    color: var(--bg);
    border-radius: 8px;
    z-index: 100;
    text-decoration: none;
  }
  .skip:focus { top: 12px; }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    background: color-mix(in oklab, var(--bg) 78%, transparent);
    border-bottom: 1px solid color-mix(in oklab, var(--line) 70%, transparent);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 20px;
    height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-right: auto;
  }
  .brand-mark {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    height: 20px;
  }
  .brand-mark i {
    width: 3px;
    border-radius: 2px;
    background: linear-gradient(var(--wave-a), var(--wave-b));
    animation: eq 1.4s ease-in-out infinite;
  }
  .brand-mark i:nth-child(1) { height: 40%; animation-delay: -0.2s; }
  .brand-mark i:nth-child(2) { height: 85%; animation-delay: -0.6s; }
  .brand-mark i:nth-child(3) { height: 60%; animation-delay: -1s; }
  .brand-mark i:nth-child(4) { height: 100%; animation-delay: -0.4s; }
  .brand-mark i:nth-child(5) { height: 45%; animation-delay: -0.8s; }
  .brand:not(:hover) .brand-mark i { animation-play-state: paused; }
  @keyframes eq {
    0%, 100% { transform: scaleY(1); }
    50% { transform: scaleY(0.45); }
  }

  nav ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 14.5px;
    color: var(--ink-2);
    text-decoration: none;
  }
  nav a:hover { color: var(--ink); background: var(--line); }
  nav a[aria-current='page'] { color: var(--ink); background: var(--line); }

  .theme-toggle {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink-2);
    cursor: pointer;
    flex: none;
  }
  .theme-toggle:hover { color: var(--ink); border-color: var(--line-strong); }
  .icon-moon { display: none; }
  :global(:root[data-theme='dark']) .icon-sun { display: none; }
  :global(:root[data-theme='dark']) .icon-moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-sun { display: none; }
    :global(:root:not([data-theme='light'])) .icon-moon { display: block; }
  }

  @media (max-width: 640px) {
    .bar { gap: 8px; height: 56px; }
    .brand-name { display: none; }
    nav a { padding: 6px 9px; font-size: 14px; }
    nav ul { gap: 0; }
  }

  .site-footer {
    margin-top: 120px;
    border-top: 1px solid var(--line);
    padding-block: 48px 28px;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 28px;
  }
  .foot-name { font-size: 30px; margin: 0; }
  .foot-meta { color: var(--muted); margin: 6px 0 0; font-size: 15px; }
  .foot-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-content: flex-start;
  }
  .foot-links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    text-decoration: none;
    font-size: 14px;
    color: var(--ink-2);
  }
  .foot-links a:hover { border-color: var(--accent); color: var(--accent-ink); }
  .foot-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    margin-top: 40px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
</style>
